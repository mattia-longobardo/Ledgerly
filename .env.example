# Copy to .env (chmod 600) and fill in. .env is git-ignored: NEVER commit secrets.
# Generate the three app secrets with: openssl rand -base64 32

# Hostname served by Traefik. LAN + NetBird only via Pi-hole split-DNS — no Cloudflared ingress.
DASHBOARD_HOST=dash.longobardo.me

# Password of the least-privilege `dashboard` role on the shared Postgres (db/ stack).
DB_DASHBOARD_PASSWORD=change-me

# Authentik host used to build OIDC_ISSUER = https://${AUTHENTIK_HOST}/application/o/dashboard/
AUTHENTIK_HOST=auth.longobardo.me
# Authentik OAuth2/OIDC provider credentials for the `dashboard` application (confidential client, PKCE).
DASHBOARD_OIDC_CLIENT_ID=
DASHBOARD_OIDC_CLIENT_SECRET=
# Auth.js session secret — openssl rand -base64 32
DASHBOARD_AUTH_SECRET=
# Immutable Authentik user UUID (the `sub` claim) of the single authorized owner.
DASHBOARD_AUTHORIZED_SUB=

# Shared secret for the supercronic sidecar -> /api/jobs/* calls — openssl rand -base64 32
DASHBOARD_CRON_SECRET=
# Shared secret for inbound provider webhooks -> /api/v1/webhooks/<provider> — openssl rand -base64 32
DASHBOARD_WEBHOOK_SECRET=

# Payroll document store. `silo` (the default) reads its endpoint, bucket and
# credentials from the connection you create in Settings > Integrations — no
# secret belongs here. `local` writes into DOCUMENT_STORE_LOCAL_PATH and is for
# development only: the container is read-only in production.
DASHBOARD_DOCUMENT_STORE_DRIVER=silo

# Upload malware scanning. `none` (the default) records that nothing scanned the
# file; `clamd` needs a reachable clamd on CLAMD_HOST:CLAMD_PORT.
DASHBOARD_MALWARE_SCANNER=none

# Gotify: internal service URL on proxy_public, plus an application token created in the Gotify UI.
GOTIFY_URL=http://gotify
DASHBOARD_GOTIFY_TOKEN=

# LLM-assisted payslip parsing pass — any OpenAI-COMPATIBLE Chat Completions endpoint.
#
# ALL THREE ARE OPTIONAL. With no key the pass is skipped and the deterministic
# rules parser stands alone (lower confidence, nothing breaks).
#
# These are only the FALLBACK layer: Dashboard → Settings → “Payslip AI” stores a
# base URL, a model and a key in the database, and each of those WINS over the
# value here, field by field — so the provider can be repointed from the UI
# without editing this file or redeploying. Leave them blank to configure
# everything from the UI instead.
#
# OPENAI_BASE_URL points at the API root, WITHOUT the /chat/completions leaf:
#   https://api.openai.com/v1        (default when unset)
#   https://openrouter.ai/api/v1
#   http://ollama:11434/v1           (a self-hosted shim; plain http is accepted
#                                     by the UI only for a private/LAN host)
OPENAI_API_KEY=
OPENAI_BASE_URL=
# Defaults to gpt-4.1-mini when unset — cheap, and reliable at forced tool calls.
LLM_MODEL=

# The Wallet and Trek credentials are no longer files mounted into the
# container: both are entered from the running app, in Settings > Integrations,
# and stored encrypted in the database under APP_ENCRYPTION_KEY below. Trek's
# MCP endpoint URL is part of that stored credential too — there is no
# TREK_HOST here any more.

# Credential encryption for stored integration credentials (AES-256-GCM).
# Format: keyId:base64key[,keyId:base64key] — the FIRST entry is the active key,
# later entries exist only to decrypt credentials sealed before a rotation.
# Each key must be exactly 32 bytes once base64-decoded:
#   printf 'k1:%s' "$(openssl rand -base64 32)"
# Rotating: put the NEW key first, keep the old one, redeploy, then reconnect
# each integration from Settings > Integrations to re-seal under the new key,
# and only then drop the old entry.
DASHBOARD_APP_ENCRYPTION_KEY=
