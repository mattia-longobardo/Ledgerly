# .env.example — the shape of `.env.homelab`, the deployment's environment (docker-compose.yml
# `env_file`). Copy it to `.env.homelab` and replace every value; that file is never committed, and
# no value in it may contain a `$` (Compose would interpolate it and truncate the value).
# NODE_ENV is set by the image; do not set it here.

# The homelab Postgres, reached by its service name on `db_internal` (README, Operations).
DATABASE_URL=postgres://ledgerly:<password>@postgres:5432/ledgerly

# The public address; Better Auth checks it against `trustedOrigins` and the OAuth redirect_uri.
BETTER_AUTH_URL=https://dash.longobardo.me
# 32+ characters: `openssl rand -base64 32`. The value below is a placeholder the app refuses.
BETTER_AUTH_SECRET=change-me-change-me-change-me-change-me

# Authentik (README, Operations).
OIDC_DISCOVERY_URL=https://auth.longobardo.me/application/o/ledgerly/.well-known/openid-configuration
OIDC_CLIENT_ID=<client id>
OIDC_CLIENT_SECRET=<client secret>
OIDC_ADMIN_GROUP=Ledgerly

# Stalwart, implicit TLS on 465.
SMTP_HOST=mx.longobardo.me
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@longobardo.me
SMTP_PASSWORD=<mailbox password>
# Required when SMTP_USER is set and SMTP_SECURE is not true.
SMTP_REQUIRE_TLS=false
MAIL_FROM=Ledgerly <no-reply@longobardo.me>

# Silo, on `db_internal`: one bucket named after the app.
S3_ENDPOINT=http://silo:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=<access key>
S3_SECRET_ACCESS_KEY=<secret key>
S3_BUCKET=ledgerly

# Credential encryption (spec §9.4): `id:base64[,older…]`, 32 bytes of base64 per key. The first
# key seals; the older ones stay so already-sealed credentials keep opening. Rotate by prepending a
# new key: `openssl rand -base64 32`. The value below is a placeholder the app refuses.
APP_ENCRYPTION_KEY=dev:1fXJEH66bW3y0iE+bgEqimdJ1uEjw3fXyqeUmHosTdA=

# 32+ characters; the cron sidecar sends the same value. The value below is a placeholder.
CRON_SECRET=dev-cron-secret-dev-cron-secret-dev
HEARTBEAT_FILE=/tmp/ledgerly-heartbeat

# 32+ characters: bearer token for GET /api/metrics. The value below is a placeholder.
METRICS_TOKEN=dev-metrics-token-dev-metrics-token

# Reverse proxies in front of the app: comma-separated IPs or CIDR ranges (Traefik's address on its
# Docker network). The app then reads each client's own address from X-Forwarded-For, so sign-in
# rate limits count per client. Empty: every request shares one bucket.
TRUSTED_PROXY_IPS=

# Read by docker-compose.yml for the Traefik router, not by the app itself.
LEDGERLY_HOST=dash.longobardo.me
