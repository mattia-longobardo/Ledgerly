# .env.example — copy to .env for local development (values match compose.dev.yml).
# NODE_ENV is set automatically by Next.js (dev/build/start); do not set it here.

DATABASE_URL=postgres://ledgerly:ledgerly@127.0.0.1:55432/ledgerly_dev
TEST_DATABASE_URL=postgres://ledgerly:ledgerly@127.0.0.1:55432/ledgerly_test

# Use 127.0.0.1, not localhost: Better Auth checks this against `trustedOrigins` and the OAuth
# state cookie/redirect_uri on every sign-in, and `npm run dev` binds to 127.0.0.1 to match.
BETTER_AUTH_URL=http://127.0.0.1:3000
# 32+ characters: `openssl rand -base64 32`. Generate a fresh one for every deployment.
BETTER_AUTH_SECRET=change-me-change-me-change-me-change-me

# compose.dev.yml services
# (Postgres 55432, MinIO 59000/59001, Mailpit 51025/58025, mock OIDC 58090)
OIDC_DISCOVERY_URL=http://127.0.0.1:58090/default/.well-known/openid-configuration
OIDC_CLIENT_ID=ledgerly
OIDC_CLIENT_SECRET=ledgerly-dev
OIDC_ADMIN_GROUP=ledgerly-admins

SMTP_HOST=127.0.0.1
SMTP_PORT=51025
SMTP_SECURE=false
# Mailpit accepts any login; leave both empty to send without authentication.
SMTP_USER=
SMTP_PASSWORD=
# Required in production when SMTP_USER is set and SMTP_SECURE is not true.
SMTP_REQUIRE_TLS=false
MAIL_FROM=Ledgerly <ledgerly@example.test>

S3_ENDPOINT=http://127.0.0.1:59000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=ledgerly
S3_SECRET_ACCESS_KEY=ledgerly-dev-secret
S3_BUCKET=ledgerly-dev

# 32+ characters.
CRON_SECRET=dev-cron-secret-dev-cron-secret-dev
HEARTBEAT_FILE=/tmp/ledgerly-heartbeat

# 32+ characters: bearer token for GET /api/metrics. Prometheus sends it via the scrape config's
# `authorization: { credentials: <token> }` (or `bearer_token`). Required in production.
METRICS_TOKEN=dev-metrics-token-dev-metrics-token

# Reverse proxies in front of the app: comma-separated IPs or CIDR ranges (for example Traefik's
# address on its Docker network). The app then reads each client's own address from
# X-Forwarded-For, so sign-in rate limits count per client. Empty: no proxy, requests arrive directly.
TRUSTED_PROXY_IPS=

# Read by docker-compose.yml for the Traefik router, not by the app itself.
LEDGERLY_HOST=dash.longobardo.me
