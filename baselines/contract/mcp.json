{
 "tools/list": {
  "tools": [
   {
    "name": "list_investments",
    "title": "Investments",
    "description": "Every investment service (broker, exchange, manual account) with its value in its own `currency` and in the display currency, net invested, gain, simple return and XIRR, plus the portfolio's totals in the display `currency`, as GET /api/v1/investments. Returns are ratios (0.05 = 5 %). Gain and returns are null unless the service's history is complete (`reliable`; `reliableFrom` says from when it is); `xirrStatus` says why XIRR is missing. The portfolio leaves out transfers between its own services and includes the exchange effect. `pnl` is the profit and loss of the period (the year running by default), the number the screen shows: realized, unrealized (open positions only), income, fees, corrections and exchange effect add up to it, and the services add up to the portfolio with `transfers`.",
    "inputSchema": {
     "$schema": "http://json-schema.org/draft-07/schema#",
     "type": "object",
     "properties": {
      "period": {
       "description": "A year (YYYY) or `all`; default the year running.",
       "type": "string",
       "pattern": "^(\\d{4}|all)$"
      },
      "from": {
       "description": "First day, YYYY-MM-DD; with `to`, wins over `period`.",
       "type": "string"
      },
      "to": {
       "description": "Last day, YYYY-MM-DD.",
       "type": "string"
      }
     }
    },
    "annotations": {
     "readOnlyHint": true,
     "destructiveHint": false,
     "idempotentHint": true,
     "openWorldHint": false
    },
    "execution": {
     "taskSupport": "forbidden"
    }
   },
   {
    "name": "get_investment_holdings",
    "title": "Investment holdings",
    "description": "The open positions of one investment service today — asset, product, quantity, price, value and gain in the service's `currency` — as GET /api/v1/investments/{accountId}/holdings. Take the account id from list_investments.",
    "inputSchema": {
     "$schema": "http://json-schema.org/draft-07/schema#",
     "type": "object",
     "properties": {
      "account_id": {
       "type": "string",
       "format": "uuid",
       "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|<id-1>|<id-2>)$",
       "description": "The service's accountId, from list_investments."
      }
     },
     "required": [
      "account_id"
     ]
    },
    "annotations": {
     "readOnlyHint": true,
     "destructiveHint": false,
     "idempotentHint": true,
     "openWorldHint": false
    },
    "execution": {
     "taskSupport": "forbidden"
    }
   },
   {
    "name": "get_summary",
    "title": "Summary",
    "description": "Net worth, liquid cash, and this month's income, spending and net, as GET /api/v1/summary. `currency` is the user's display currency, which netWorth, previousNetWorth and cash are converted to at the ECB rate of their day. `netWorthPartial`/`cashPartial` are true when an account counted has no balance yet, or no exchange rate to that currency.",
    "inputSchema": {
     "type": "object",
     "properties": {}
    },
    "annotations": {
     "readOnlyHint": true,
     "destructiveHint": false,
     "idempotentHint": true,
     "openWorldHint": false
    },
    "execution": {
     "taskSupport": "forbidden"
    }
   },
   {
    "name": "list_accounts",
    "title": "Accounts",
    "description": "Every account with its type, currency, state and today's balance, as GET /api/v1/accounts.",
    "inputSchema": {
     "type": "object",
     "properties": {}
    },
    "annotations": {
     "readOnlyHint": true,
     "destructiveHint": false,
     "idempotentHint": true,
     "openWorldHint": false
    },
    "execution": {
     "taskSupport": "forbidden"
    }
   },
   {
    "name": "get_account_balances",
    "title": "Balance history",
    "description": "The recorded balances of one account, newest first, as GET /api/v1/accounts/{id}/balances. Take the account id from list_accounts.",
    "inputSchema": {
     "$schema": "http://json-schema.org/draft-07/schema#",
     "type": "object",
     "properties": {
      "account_id": {
       "type": "string",
       "format": "uuid",
       "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|<id-1>|<id-2>)$",
       "description": "The account's id, from list_accounts."
      },
      "limit": {
       "description": "How many entries, newest first (default 50).",
       "type": "integer",
       "minimum": 1,
       "maximum": 200
      }
     },
     "required": [
      "account_id"
     ]
    },
    "annotations": {
     "readOnlyHint": true,
     "destructiveHint": false,
     "idempotentHint": true,
     "openWorldHint": false
    },
    "execution": {
     "taskSupport": "forbidden"
    }
   },
   {
    "name": "list_transactions",
    "title": "Transactions",
    "description": "Movements filtered by period, account, category, type and payee text, with the totals of the whole filtered range (not just the page), as GET /api/v1/transactions. Paginate with offset.",
    "inputSchema": {
     "$schema": "http://json-schema.org/draft-07/schema#",
     "type": "object",
     "properties": {
      "from": {
       "description": "First day included, YYYY-MM-DD.",
       "type": "string"
      },
      "to": {
       "description": "Last day included, YYYY-MM-DD.",
       "type": "string"
      },
      "account_id": {
       "description": "Only this account, from list_accounts.",
       "type": "string",
       "format": "uuid",
       "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|<id-1>|<id-2>)$"
      },
      "category_id": {
       "description": "Only this category (a group includes its sub-categories).",
       "type": "string",
       "format": "uuid",
       "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|<id-1>|<id-2>)$"
      },
      "type": {
       "type": "string",
       "enum": [
        "income",
        "expense",
        "transfer"
       ]
      },
      "payee": {
       "description": "Text the payee contains.",
       "type": "string",
       "minLength": 1,
       "maxLength": 200
      },
      "limit": {
       "description": "Page size (default 50).",
       "type": "integer",
       "minimum": 1,
       "maximum": 500
      },
      "offset": {
       "type": "integer",
       "minimum": 0,
       "maximum": 9007199254740991
      }
     }
    },
    "annotations": {
     "readOnlyHint": true,
     "destructiveHint": false,
     "idempotentHint": true,
     "openWorldHint": false
    },
    "execution": {
     "taskSupport": "forbidden"
    }
   },
   {
    "name": "list_budgets",
    "title": "Budgets",
    "description": "The budgets of one month with their limit, what was spent and the status, plus the totals and the spending no budget covers, as the Budgets page shows them.",
    "inputSchema": {
     "$schema": "http://json-schema.org/draft-07/schema#",
     "type": "object",
     "properties": {
      "month": {
       "description": "YYYY-MM; the current month when omitted.",
       "type": "string",
       "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
      }
     }
    },
    "annotations": {
     "readOnlyHint": true,
     "destructiveHint": false,
     "idempotentHint": true,
     "openWorldHint": false
    },
    "execution": {
     "taskSupport": "forbidden"
    }
   }
  ]
 },
