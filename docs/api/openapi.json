{
  "openapi": "3.1.0",
  "info": {
    "title": "Finance Dashboard API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-authjs.session-token"
      }
    },
    "schemas": {
      "AccountListResponse": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AccountListItem"
            }
          }
        },
        "required": [
          "items"
        ]
      },
      "AccountListItem": {
        "type": "object",
        "properties": {
          "account": {
            "$ref": "#/components/schemas/Account"
          },
          "latest": {
            "$ref": "#/components/schemas/BalancePoint"
          },
          "trend": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MonthPoint"
            }
          },
          "stale": {
            "type": "boolean"
          }
        },
        "required": [
          "account",
          "latest",
          "trend",
          "stale"
        ]
      },
      "Account": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "groupId": {
            "type": "string",
            "nullable": true,
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "$ref": "#/components/schemas/AccountType"
          },
          "currency": {
            "type": "string"
          },
          "origin": {
            "$ref": "#/components/schemas/AccountOrigin"
          },
          "provider": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "$ref": "#/components/schemas/AccountStatus"
          },
          "includeInNetWorth": {
            "type": "boolean"
          },
          "notes": {
            "type": "string",
            "nullable": true
          },
          "sortOrder": {
            "type": "number"
          },
          "version": {
            "type": "number"
          },
          "archivedAt": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "groupId",
          "name",
          "type",
          "currency",
          "origin",
          "provider",
          "status",
          "includeInNetWorth",
          "notes",
          "sortOrder",
          "version",
          "archivedAt",
          "createdAt",
          "updatedAt"
        ]
      },
      "AccountType": {
        "type": "string",
        "enum": [
          "checking",
          "savings",
          "cash",
          "investment",
          "pension_fund",
          "crypto",
          "credit",
          "other"
        ]
      },
      "AccountOrigin": {
        "type": "string",
        "enum": [
          "manual",
          "synced"
        ]
      },
      "AccountStatus": {
        "type": "string",
        "enum": [
          "active",
          "unavailable",
          "archived"
        ]
      },
      "BalancePoint": {
        "type": "object",
        "nullable": true,
        "properties": {
          "accountId": {
            "type": "string",
            "format": "uuid"
          },
          "asOf": {
            "type": "string"
          },
          "balance": {
            "type": "string"
          },
          "available": {
            "type": "string",
            "nullable": true
          },
          "source": {
            "$ref": "#/components/schemas/BalanceSource"
          },
          "capturedAt": {
            "type": "string"
          }
        },
        "required": [
          "accountId",
          "asOf",
          "balance",
          "available",
          "source",
          "capturedAt"
        ]
      },
      "BalanceSource": {
        "type": "string",
        "enum": [
          "manual",
          "provider",
          "system",
          "migration"
        ]
      },
      "MonthPoint": {
        "type": "object",
        "properties": {
          "month": {
            "type": "string"
          },
          "value": {
            "type": "number",
            "nullable": true
          }
        },
        "required": [
          "month",
          "value"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "requestId": {
                "type": "string"
              },
              "details": {
                "nullable": true
              }
            },
            "required": [
              "code",
              "message",
              "requestId"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "CreateAccountRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "type": {
            "$ref": "#/components/schemas/AccountType"
          },
          "currency": {
            "type": "string",
            "minLength": 3,
            "maxLength": 3
          },
          "groupId": {
            "type": "string",
            "nullable": true,
            "format": "uuid"
          },
          "includeInNetWorth": {
            "type": "boolean"
          },
          "notes": {
            "type": "string",
            "nullable": true,
            "maxLength": 2000
          },
          "openingBalance": {
            "type": "object",
            "properties": {
              "asOf": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "balance": {
                "type": "string",
                "pattern": "^-?\\d+(\\.\\d{1,2})?$"
              }
            },
            "required": [
              "asOf",
              "balance"
            ]
          }
        },
        "required": [
          "name",
          "type"
        ]
      },
      "AccountDetail": {
        "type": "object",
        "properties": {
          "account": {
            "$ref": "#/components/schemas/Account"
          },
          "latest": {
            "$ref": "#/components/schemas/BalancePoint"
          },
          "history": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BalancePoint"
            }
          },
          "series": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MonthPoint"
            }
          },
          "link": {
            "$ref": "#/components/schemas/ProviderLink"
          },
          "stale": {
            "type": "boolean"
          }
        },
        "required": [
          "account",
          "latest",
          "history",
          "series",
          "link",
          "stale"
        ]
      },
      "ProviderLink": {
        "type": "object",
        "nullable": true,
        "properties": {
          "provider": {
            "type": "string"
          },
          "entityType": {
            "type": "string",
            "enum": [
              "account"
            ]
          },
          "entityId": {
            "type": "string",
            "format": "uuid"
          },
          "externalId": {
            "type": "string"
          },
          "metadata": {
            "type": "object",
            "additionalProperties": {
              "nullable": true
            }
          },
          "missingSince": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "provider",
          "entityType",
          "entityId",
          "externalId",
          "metadata",
          "missingSince"
        ]
      },
      "UpdateAccountRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "type": {
            "$ref": "#/components/schemas/AccountType"
          },
          "currency": {
            "type": "string",
            "minLength": 3,
            "maxLength": 3
          },
          "groupId": {
            "type": "string",
            "nullable": true,
            "format": "uuid"
          },
          "includeInNetWorth": {
            "type": "boolean"
          },
          "notes": {
            "type": "string",
            "nullable": true,
            "maxLength": 2000
          },
          "sortOrder": {
            "type": "integer"
          },
          "version": {
            "type": "integer"
          }
        }
      },
      "DeleteAccountResponse": {
        "type": "object",
        "properties": {
          "outcome": {
            "type": "string",
            "enum": [
              "deleted",
              "archived"
            ]
          }
        },
        "required": [
          "outcome"
        ]
      },
      "RecordBalanceRequest": {
        "type": "object",
        "properties": {
          "asOf": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "balance": {
            "type": "string",
            "pattern": "^-?\\d+(\\.\\d{1,2})?$"
          },
          "available": {
            "type": "string",
            "nullable": true,
            "pattern": "^-?\\d+(\\.\\d{1,2})?$"
          }
        },
        "required": [
          "asOf",
          "balance"
        ]
      },
      "BalancesPage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BalancePoint"
            }
          },
          "nextCursor": {
            "type": "string"
          }
        },
        "required": [
          "items"
        ]
      },
      "AccountGroupListResponse": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AccountGroup"
            }
          }
        },
        "required": [
          "items"
        ]
      },
      "AccountGroup": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "sortOrder": {
            "type": "number"
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "sortOrder",
          "createdAt",
          "updatedAt"
        ]
      },
      "CreateGroupRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "sortOrder": {
            "type": "integer"
          }
        },
        "required": [
          "name"
        ]
      },
      "RenameGroupRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "required": [
          "name"
        ]
      },
      "DeleteResponse": {
        "type": "object",
        "properties": {
          "deleted": {
            "type": "boolean",
            "enum": [
              true
            ]
          }
        },
        "required": [
          "deleted"
        ]
      },
      "WalletSyncResult": {
        "type": "object",
        "properties": {
          "created": {
            "type": "number"
          },
          "updated": {
            "type": "number"
          },
          "adopted": {
            "type": "number"
          },
          "balances": {
            "type": "number"
          },
          "missing": {
            "type": "number"
          }
        },
        "required": [
          "created",
          "updated",
          "adopted",
          "balances",
          "missing"
        ]
      },
      "NetWorthSeries": {
        "type": "object",
        "properties": {
          "months": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "total": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MonthPoint"
            }
          },
          "perAccount": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NetWorthAccountSeries"
            }
          },
          "asOf": {
            "type": "string",
            "nullable": true
          },
          "stale": {
            "type": "boolean"
          },
          "unavailableCount": {
            "type": "number"
          }
        },
        "required": [
          "months",
          "total",
          "perAccount",
          "asOf",
          "stale",
          "unavailableCount"
        ]
      },
      "NetWorthAccountSeries": {
        "type": "object",
        "properties": {
          "account": {
            "$ref": "#/components/schemas/Account"
          },
          "series": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MonthPoint"
            }
          },
          "latest": {
            "$ref": "#/components/schemas/BalancePoint"
          }
        },
        "required": [
          "account",
          "series",
          "latest"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/v1/accounts": {
      "get": {
        "tags": [
          "Accounts"
        ],
        "security": [
          {
            "session": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "enum": [
                "true",
                "false"
              ]
            },
            "required": false,
            "name": "includeArchived",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "pattern": "^\\d+$"
            },
            "required": false,
            "name": "months",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "The caller's accounts, each with its latest balance and a monthly trend.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountListResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Accounts"
        ],
        "security": [
          {
            "session": []
          }
        ],
        "description": "Requires an `Idempotency-Key` header.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateAccountRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The created account.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Account"
                }
              }
            }
          },
          "422": {
            "description": "Validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/accounts/{id}": {
      "get": {
        "tags": [
          "Accounts"
        ],
        "security": [
          {
            "session": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          },
          {
            "schema": {
              "type": "string",
              "pattern": "^\\d+$"
            },
            "required": false,
            "name": "months",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Account detail.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountDetail"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "Accounts"
        ],
        "security": [
          {
            "session": []
          }
        ],
        "description": "Send the current version in the `If-Match` header (or `version` in the body).",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateAccountRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The updated account.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Account"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Accounts"
        ],
        "security": [
          {
            "session": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "true",
                "false"
              ]
            },
            "required": false,
            "name": "confirmSynced",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Deleted or archived, depending on whether anything still references the account.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeleteAccountResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/accounts/{id}/balances": {
      "post": {
        "tags": [
          "Accounts"
        ],
        "security": [
          {
            "session": []
          }
        ],
        "description": "Requires an `Idempotency-Key` header. Manual accounts only.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecordBalanceRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The recorded balance.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BalancePoint"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Accounts"
        ],
        "security": [
          {
            "session": []
          }
        ],
        "description": "Newest first. `cursor` is the base64url of the previous page's last `asOf`.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          },
          {
            "schema": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "required": false,
            "name": "from",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "required": false,
            "name": "to",
            "in": "query"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "cursor",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "pattern": "^\\d+$"
            },
            "required": false,
            "name": "limit",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "A page of balances.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BalancesPage"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/account-groups": {
      "get": {
        "tags": [
          "Account groups"
        ],
        "security": [
          {
            "session": []
          }
        ],
        "responses": {
          "200": {
            "description": "The caller's account groups.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountGroupListResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Account groups"
        ],
        "security": [
          {
            "session": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateGroupRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The created group.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountGroup"
                }
              }
            }
          },
          "422": {
            "description": "Validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/account-groups/{id}": {
      "patch": {
        "tags": [
          "Account groups"
        ],
        "security": [
          {
            "session": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
