{
  "name": "ledgerly",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "scripts": {
    "prebuild": "node scripts/copy-pdfjs.mjs",
    "build": "next build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project 'unit-*'",
    "test:watch": "vitest --project 'unit-*'",
    "test:integration": "sh scripts/test-integration.sh",
    "perf": "sh scripts/perf-on-test.sh",
    "e2e": "playwright test",
    "docs:shots": "playwright test --config playwright.shots.config.ts",
    "db:generate": "drizzle-kit generate",
    "user:create-admin": "sh scripts/on-homelab.sh scripts/create-admin.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1131.0",
    "@base-ui/react": "1.8.0",
    "@fontsource-variable/inter": "5.3.0",
    "@node-rs/argon2": "2.2.1",
    "better-auth": "1.7.4",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.8",
    "jose": "6.2.12",
    "lucide-react": "1.45.0",
    "next": "16.3.5",
    "next-intl": "4.14.4",
    "nodemailer": "10.0.9",
    "pdfjs-dist": "6.3.289",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "unpdf": "1.8.1",
    "use-intl": "4.14.4",
    "yazl": "3.3.1",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "@vitejs/plugin-react": "6.1.1",
    "axe-core": "^4.13.0",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "jsdom": "29.1.1",
    "pdf-lib": "1.17.1",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vitest": "5.0.0",
    "yauzl": "3.4.0"
  }
}
